---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';

const pageTitle = 'Projeler | Muhammet Talha Demir - Oyun & Yazılım Geliştirici';
const pageDescription =
	"Bilgisayar mühendisliği öğrencisi Muhammet Talha Demir'in oyun geliştirme, mobil, web ve hackathon projeleri. Kaynak kodlar, canlı demolar ve detaylar.";
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 820px;
				margin: 0 auto;
				padding: 2.5em 1em 4em 1em;
			}

			.page-header {
				margin-bottom: 2.5rem;
			}

			.page-header h1 {
				font-size: 2.2rem;
				color: rgb(var(--black));
				margin-bottom: 0.5rem;
			}

			.page-header p {
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
				margin: 0;
				line-height: 1.6;
			}

			.projects-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1.4rem;
			}

			.project-card {
				background: rgba(var(--gray-light), 0.4);
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 14px;
				padding: 1.5rem 1.6rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
			}

			:global(html.dark) .project-card {
				background: rgba(var(--gray-light), 0.6);
				border: 1px solid rgba(var(--gray), 0.22);
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
			}

			.project-card:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
				background: rgba(var(--gray-light), 0.6);
				box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
			}

			:global(html.dark) .project-card:hover {
				background: rgba(var(--gray-light), 0.85);
				box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
			}

			.project-title {
				font-size: 1.3rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0 0 0.4rem 0;
				line-height: 1.3;
			}

			.project-desc {
				font-size: 1rem;
				line-height: 1.65;
				color: rgb(var(--gray-dark));
				margin: 0;
			}

			.project-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: center;
				margin-top: 0.2rem;
				padding-top: 0.8rem;
				border-top: 1px solid rgba(var(--gray), 0.15);
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.45rem 0.9rem;
				border-radius: 8px;
				font-size: 0.88rem;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.2s ease;
				background: rgba(var(--gray-light), 0.7);
				color: rgb(var(--black));
				border: 1px solid rgba(var(--gray), 0.25);
			}

			.btn:hover {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
				transform: translateY(-1px);
			}

			.btn svg {
				width: 16px;
				height: 16px;
				flex-shrink: 0;
			}

			.btn-primary {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
			}

			.btn-primary:hover {
				opacity: 0.9;
				transform: translateY(-1px);
			}

			@media (max-width: 720px) {
				main {
					padding: 2em 1em 3em 1em;
				}

				.page-header h1 {
					font-size: 1.8rem;
				}

				.project-card {
					padding: 1.25rem 1.15rem;
					gap: 0.85rem;
				}

				.project-title {
					font-size: 1.2rem;
				}

				.project-desc {
					font-size: 0.95rem;
					line-height: 1.6;
				}

				.project-actions {
					gap: 0.55rem;
				}

				.btn {
					padding: 0.4rem 0.75rem;
					font-size: 0.84rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Projeler</h1>
				<p>Geliştirdiğim oyunlar, mobil uygulamalar, web projeleri ve hackathon çalışmaları.</p>
			</div>

			<ul class="projects-list">
				{
					projects.map((project) => (
						<li class="project-card">
							<div class="project-content">
								<h2 class="project-title">{project.title}</h2>
								<p class="project-desc">{project.description}</p>
							</div>

							<div class="project-actions">
								{project.blogUrl && (
									<a href={project.blogUrl} class="btn">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
											<path d="M6 6h10" />
											<path d="M6 10h10" />
										</svg>
										<span>Blog Yazısı</span>
									</a>
								)}

								{project.repoUrl && (
									<a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn">
										<svg viewBox="0 0 16 16" fill="currentColor">
											<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
										</svg>
										<span>GitHub</span>
									</a>
								)}

								{project.liveUrl && (
									<a href={project.liveUrl.url} target="_blank" rel="noopener noreferrer" class="btn">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
											<polyline points="15 3 21 3 21 9" />
											<line x1="10" y1="14" x2="21" y2="3" />
										</svg>
										<span>{project.liveUrl.text}</span>
									</a>
								)}
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
