---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import profilePhoto from '../assets/profil.jpg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';

const latestPosts = (await getCollection('blog', ({ data }) => !data.hidden))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const latestProjects = projects.slice(0, 3);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 800px;
				margin: 0 auto;
				padding: 3em 1em 4em 1em;
			}

			/* Hero Bölümü (CV Tarzı) */
			.hero-section {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2.5rem;
				margin-bottom: 3.5rem;
			}

			.hero-text {
				flex: 1;
			}

			.hero-text h1 {
				font-size: 2.15rem;
				margin-bottom: 0.8rem;
				line-height: 1.25;
				color: rgb(var(--black));
			}

			.intro-p {
				font-size: 1.15rem;
				line-height: 1.65;
				margin: 0;
				color: rgb(var(--gray-dark));
			}

			.hero-image-wrapper {
				flex-shrink: 0;
			}

			.profile-img {
				width: 155px;
				height: 155px;
				border-radius: 50%;
				object-fit: cover;
				object-position: center 48%;
				border: 3px solid rgba(var(--accent), 0.35);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
				display: block;
				transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
			}

			.profile-img:hover {
				transform: scale(1.03);
				border-color: var(--accent);
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
			}

			/* Bölüm Başlıkları ve Listeleri */
			.blog-section,
			.projects-section {
				margin-bottom: 3.5rem;
			}

			.section-header {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}

			.section-header h2 {
				font-size: 1.45rem;
				margin: 0;
				color: rgb(var(--black));
			}

			.all-posts-link {
				font-size: 0.95rem;
				font-weight: 600;
				text-decoration: none;
				color: var(--accent);
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.all-posts-link:hover {
				transform: translateX(3px);
				opacity: 0.9;
			}

			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.post-card,
			.project-mini-card {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1.2rem;
				padding: 1rem 1.25rem;
				border-radius: 12px;
				background: rgba(var(--gray-light), 0.4);
				border: 1px solid rgba(var(--gray), 0.18);
				text-decoration: none;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
				transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
			}

			:global(html.dark) .post-card,
			:global(html.dark) .project-mini-card {
				background: rgba(var(--gray-light), 0.6);
				border: 1px solid rgba(var(--gray), 0.22);
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
			}

			.post-card:hover,
			.project-mini-card:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
				background: rgba(var(--gray-light), 0.6);
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
			}

			:global(html.dark) .post-card:hover,
			:global(html.dark) .project-mini-card:hover {
				background: rgba(var(--gray-light), 0.85);
				box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
			}

			.post-card:hover .post-title,
			.project-mini-card:hover .post-title {
				color: var(--accent);
			}

			.post-info {
				flex: 1;
				min-width: 0;
			}

			.post-title {
				font-size: 1.08rem;
				font-weight: 700;
				margin: 0 0 0.25rem 0;
				color: rgb(var(--black));
				transition: color 0.2s ease;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.post-desc {
				font-size: 0.88rem;
				margin: 0;
				color: rgb(var(--gray-dark));
				opacity: 0.85;
				line-height: 1.4;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.post-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				flex-shrink: 0;
			}

			/* Proje Kartı Butonları */
			.project-actions {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-shrink: 0;
			}

			.mini-btn {
				display: inline-flex;
				align-items: center;
				padding: 0.35rem 0.75rem;
				border-radius: 6px;
				font-size: 0.82rem;
				font-weight: 600;
				text-decoration: none;
				background: rgba(var(--gray-light), 0.7);
				color: rgb(var(--black));
				border: 1px solid rgba(var(--gray), 0.25);
				transition: all 0.2s ease;
			}

			.mini-btn:hover {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
				transform: translateY(-1px);
			}

			/* İletişim Bölümü */
			.contact-section {
				padding-top: 1.8rem;
				border-top: 1px solid rgba(var(--gray), 0.2);
			}

			.contact-section h2 {
				font-size: 1.45rem;
				margin-bottom: 0.5rem;
				color: rgb(var(--black));
			}

			.contact-intro {
				font-size: 1.05rem;
				margin-bottom: 1rem;
				color: rgb(var(--gray-dark));
			}

			.contact-links {
				font-size: 1rem;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.6rem;
				color: rgb(var(--gray));
				margin: 0;
			}

			.contact-link {
				color: rgb(var(--black));
				text-decoration: none;
				font-weight: 600;
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				line-height: 1.2;
				transition: color 0.2s ease;
			}

			.contact-link:hover {
				color: var(--accent);
			}

			.contact-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				transform: translateY(-2px);
			}

			.contact-icon.email-icon {
				display: inline-flex;
				transform: translateY(-1px);
			}

			.linkedin-icon {
				stroke: #0a66c2;
			}

			.sep {
				color: rgb(var(--gray));
				opacity: 0.6;
			}

			/* Mobil Uyumluluk */
			@media (max-width: 720px) {
				main {
					padding: 2em 1em 3em 1em;
				}

				.hero-section {
					flex-direction: column-reverse;
					text-align: center;
					gap: 1.5rem;
					margin-bottom: 2.8rem;
				}

				.hero-text h1 {
					font-size: 1.75rem;
				}

				.profile-img {
					width: 130px;
					height: 130px;
					margin: 0 auto;
				}

				.post-card,
				.project-mini-card {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.6rem;
				}

				.project-actions {
					flex-wrap: wrap;
					width: 100%;
					gap: 0.4rem;
				}

				.post-title,
				.post-desc {
					white-space: normal;
				}

				.post-date {
					font-size: 0.8rem;
				}

				.contact-links {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.5rem;
				.sep {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-section">
				<div class="hero-text">
					<h1>Merhaba, Ben Muhammet Talha Demir 👋</h1>
					<p class="intro-p">
						Erciyes Üniversitesi'nde <strong>Bilgisayar Mühendisliği</strong> öğrencisiyim. 
						<strong>C#</strong> ve <strong>Unity</strong> ile oyun geliştirme süreçlerine odaklanırken, yapay zeka destekli modern yazılım araçlarıyla yenilikçi projeler üretmeye devam ediyorum.
					</p>
				</div>
				<div class="hero-image-wrapper">
					<Image 
						src={profilePhoto} 
						alt="Muhammet Talha Demir" 
						width={300} 
						height={300}
						class="profile-img"
						loading="eager"
					/>
				</div>
			</section>

			<section class="blog-section">
				<div class="section-header">
					<h2>Son Blog Yazıları</h2>
					<a href="/blog" class="all-posts-link">Tümünü Gör →</a>
				</div>
				<ul class="posts-list">
					{
						latestPosts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`} class="post-card">
									<div class="post-info">
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-desc">{post.data.description}</p>
									</div>
									<div class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="projects-section">
				<div class="section-header">
					<h2>Son Projeler</h2>
					<a href="/projects" class="all-posts-link">Tümünü Gör →</a>
				</div>
				<ul class="posts-list">
					{
						latestProjects.map((project) => (
							<li class="post-item">
								<div class="project-mini-card">
									<div class="post-info">
										<h3 class="post-title">{project.title}</h3>
										<p class="post-desc">{project.description}</p>
									</div>
									<div class="project-actions">
										{project.blogUrl && (
											<a href={project.blogUrl} class="mini-btn">
												Blog
											</a>
										)}
										{project.repoUrl && (
											<a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="mini-btn">
												GitHub
											</a>
										)}
										{project.liveUrl && (
											<a href={project.liveUrl.url} target="_blank" rel="noopener noreferrer" class="mini-btn">
												{project.liveUrl.text}
											</a>
										)}
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</section>

			<section class="contact-section">
				<h2>İletişim</h2>
				<p class="contact-intro">
					Bir proje, iş birliği ya da staj fırsatı için bana ulaşabilirsin.
				</p>
				<p class="contact-links">
					<a href="mailto:contact@muhammettalhademir.com" class="contact-link">
						<span class="contact-icon email-icon">📧</span>
						<span>contact@muhammettalhademir.com</span>
					</a>
					<span class="sep">·</span>
					<a href="https://www.linkedin.com/in/muhammettalhademir" target="_blank" rel="noopener noreferrer" class="contact-link">
						<svg class="contact-icon linkedin-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0A66C2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
							<rect width="4" height="12" x="2" y="9" />
							<circle cx="4" cy="4" r="2" />
						</svg>
						<span>LinkedIn</span>
					</a>
					<span class="sep">·</span>
					<a href="https://github.com/MuhammetTalhaDemir" target="_blank" rel="noopener noreferrer" class="contact-link">
						<svg class="contact-icon github-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
						</svg>
						<span>GitHub</span>
					</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>